---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Financial Models - Dan McSpirit">
  <div id="shell">
    <!-- IDENTITY COLUMN -->
    <aside class="col col-identity">
      <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 30px;">
        <div class="name">Dan McSpirit</div>
        <div class="metadata">Denver, Colorado</div>
      </div>

      <h1 style="margin-bottom: 20px;">
        Financial Models
      </h1>

      <p style="margin-bottom: 28px; color: var(--faint); font-size: 14px;">
        Downloadable models behind the published analysis. Change the inputs; the results update.
      </p>

      <div class="divider"></div>

      <a href="/" class="lnk" style="display: inline-block; margin-top: 24px; font-size: 13px;">← Back to portfolio</a>

      <div style="height: 46px;"></div>
      <div class="scrollfade"></div>
    </aside>

    <!-- MODEL COLUMN -->
    <section class="col col-projects">
      <div class="pad">
        <div class="model-entry">
          <h2 class="project-title" style="margin-bottom: 24px;">ETH • Scenario Valuation • v1.0, Nov 2026</h2>

          <div class="button-row">
            <a href="/models/ETH_Scenario-Valuation_v1.0_2026-11.xlsx" download class="btn btn-primary">Download Excel (.xlsx)</a>
            <a href="https://docs.google.com/spreadsheets/d/1GtJp-3DEuXgdljC7DHpar8SmHDjSaZFI/copy" target="_blank" class="btn btn-secondary">Open in Google Sheets (make a copy)</a>
          </div>

          <div class="link-row">
            <a href="/models/ETH_Model-Release_2026-11.pdf" target="_blank" class="lnk">Model overview</a>
            <a href="/eth-more-lanes-less-toll.pdf" target="_blank" class="lnk">Read Part 1</a>
            <a href="/eth-the-bond-and-the-money.pdf" target="_blank" class="lnk">Read Part 2</a>
          </div>
        </div>

        <div class="model-entry">
          <h2 class="project-title" style="margin-bottom: 24px;">CRWV · Scenario Valuation · v1.1, Dec 2026</h2>

          <div class="button-row">
            <a href="/models/CRWV_Scenario-Valuation_v1.1_2026-12.xlsx" download class="btn btn-primary">Download Excel (.xlsx)</a>
            <a href="https://docs.google.com/spreadsheets/d/1hzlt1UEXsDycnDVf5cr2U8GTxew3gJXX/copy" target="_blank" class="btn btn-secondary">Open in Google Sheets (make a copy)</a>
          </div>

          <div class="link-row">
            <a href="/models/CRWV_Model-Release_2026-12.pdf" target="_blank" class="lnk">Model overview</a>
            <a href="/neoclouds-getting-to-the-other-side.pdf" target="_blank" class="lnk">Read the analysis</a>
          </div>
        </div>

        <div class="model-entry">
          <h2 class="project-title" style="margin-bottom: 24px;">IREN · Scenario Valuation · v1.1, Dec 2026</h2>

          <div class="button-row">
            <a href="/models/IREN_Scenario-Valuation_v1.1_2026-12.xlsx" download class="btn btn-primary">Download Excel (.xlsx)</a>
            <a href="https://docs.google.com/spreadsheets/d/1M4z6kCmrt7tjbPdxvYg01oEGYU2RAeKr/copy" target="_blank" class="btn btn-secondary">Open in Google Sheets (make a copy)</a>
          </div>

          <div class="link-row">
            <a href="/models/IREN_Model-Release_2026-12.pdf" target="_blank" class="lnk">Model overview</a>
            <a href="/neoclouds-getting-to-the-other-side.pdf" target="_blank" class="lnk">Read the analysis</a>
          </div>
        </div>

        <div class="model-entry">
          <h2 class="project-title" style="margin-bottom: 24px;">NBIS · Scenario Valuation · v1.1, Dec 2026</h2>

          <div class="button-row">
            <a href="/models/NBIS_Scenario-Valuation_v1.1_2026-12.xlsx" download class="btn btn-primary">Download Excel (.xlsx)</a>
            <a href="https://docs.google.com/spreadsheets/d/1iSGna7c4LrzwEsXewkkRStFQLPbjG5N_/copy" target="_blank" class="btn btn-secondary">Open in Google Sheets (make a copy)</a>
          </div>

          <div class="link-row">
            <a href="/models/NBIS_Model-Release_2026-12.pdf" target="_blank" class="lnk">Model overview</a>
            <a href="/neoclouds-getting-to-the-other-side.pdf" target="_blank" class="lnk">Read the analysis</a>
          </div>
        </div>
      </div>

      <div class="scrollfade"></div>
    </section>
  </div>
</MainLayout>

<style>
  .divider {
    height: 1px;
    background: var(--rule);
    margin: 40px 0;
  }

  .model-entry {
    max-width: 640px;
  }

  .model-entry + .model-entry {
    margin-top: 56px;
    padding-top: 40px;
    border-top: 1px solid var(--rule);
  }

  .inline-link {
    color: var(--navy);
    text-decoration: none;
    border-bottom: 1px solid var(--navy);
  }

  .button-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 24px;
  }

  .btn {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 500;
    line-height: 1;
    padding: 8px 12px;
    border-radius: 3px;
    text-decoration: none;
    border: 1px solid var(--navy);
    transition: background 0.15s, color 0.15s;
  }

  .btn-primary {
    background: var(--navy);
    color: var(--paper-light);
  }

  .btn-primary:hover {
    background: #1B3558;
  }

  .btn-secondary {
    background: transparent;
    color: var(--navy);
  }

  .btn-secondary:hover {
    background: #f5f3f0;
  }

  .link-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin-bottom: 40px;
  }

  .link-row .lnk {
    font-size: 17px;
  }
</style>

---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Value Framework - Dan McSpirit">
  <div id="shell">
    <!-- IDENTITY COLUMN -->
    <aside class="col col-identity">
      <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 30px;">
        <div class="name">Dan McSpirit</div>
        <div class="metadata">Denver, Colorado</div>
      </div>

      <h1 style="margin-bottom: 20px;">
        Value Framework
      </h1>

      <p style="margin-bottom: 16px;">
        How capital allocation determines whether value gets created or destroyed.
      </p>

      <p style="margin-bottom: 28px; color: var(--faint); font-size: 14px;">
        The principles that guide my work as an investor and builder. Teaching forces the clarity.
      </p>

      <div class="divider"></div>

      <a href="/" class="lnk" style="display: inline-block; margin-top: 24px; font-size: 13px;">← Back to portfolio</a>

      <div style="height: 46px;"></div>
      <div class="scrollfade"></div>
    </aside>

    <!-- CONCEPTS COLUMN -->
    <section class="col col-work">
      <div class="stickyhead">
        <span class="col-header-label" style="color: var(--navy);">Slides</span>
      </div>

      <div class="pad" style="padding: 30px var(--sp-5xl);">
        <div class="slide-list" id="slide-list">
          <!-- Populated by JavaScript -->
        </div>
      </div>

      <div class="scrollfade"></div>
    </section>

    <!-- SLIDE COLUMN -->
    <section class="col col-projects">
      <div class="pad" style="padding: var(--sp-3xl) var(--sp-5xl);">
        <div id="slide-viewer">
          <img id="slide-image" src="" alt="Slide" style="width: 100%; height: auto; border-radius: 4px;">
        </div>
        <div id="slide-counter" style="text-align: center; margin-top: 16px; font-size: 13px; color: var(--faint);">
          <span id="current-slide">1</span> / <span id="total-slides">39</span>
        </div>
      </div>

      <div class="scrollfade"></div>
    </section>
  </div>
</MainLayout>

<style>
  .divider {
    height: 1px;
    background: var(--rule);
    margin: 40px 0;
  }

  .slide-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .slide-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 16px;
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--rule-light);
    cursor: pointer;
    text-align: left;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
    font-size: 13px;
    font-weight: 400;
    color: var(--navy);
    transition: background 0.2s;
  }

  .slide-item:hover {
    background: #faf8f3;
  }

  .slide-item.active {
    background: #f5f3f0;
    border-left: 3px solid var(--navy);
    padding-left: 13px;
  }

  .slide-number {
    font-size: 11px;
    color: var(--faint);
    flex-shrink: 0;
    margin-left: 8px;
  }

  .slide-title {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>

<script>
const slides = [
  { id: "slide-01", num: 1, title: "Value Creation, Strategy & Other Thoughts", image: "/value-framework-slides/slide-01.png" },
  { id: "slide-02", num: 2, title: "Seasoned Navigator: Multi-cycle experience", image: "/value-framework-slides/slide-02.png" },
  { id: "slide-03", num: 3, title: "The DuPont Framework", image: "/value-framework-slides/slide-03.png" },
  { id: "slide-04", num: 4, title: "Positioning: Are you in the value creation game?", image: "/value-framework-slides/slide-04.png" },
  { id: "slide-05", num: 5, title: "Sustainability", image: "/value-framework-slides/slide-05.png" },
  { id: "slide-06", num: 6, title: "Value: The Math", image: "/value-framework-slides/slide-06.png" },
  { id: "slide-07", num: 7, title: "NOPAT: Operating Earnings", image: "/value-framework-slides/slide-07.png" },
  { id: "slide-08", num: 8, title: "Sales Margin: Operating Efficiency", image: "/value-framework-slides/slide-08.png" },
  { id: "slide-09", num: 9, title: "ROIC: Capital Efficiency", image: "/value-framework-slides/slide-09.png" },
  { id: "slide-10", num: 10, title: "Systems View: How It Works Together", image: "/value-framework-slides/slide-10.png" },
  { id: "slide-11", num: 11, title: "Strategic Positioning", image: "/value-framework-slides/slide-11.png" },
  { id: "slide-12", num: 12, title: "Competitive Advantage: The Formula", image: "/value-framework-slides/slide-12.png" },
  { id: "slide-13", num: 13, title: "Sources of Advantage", image: "/value-framework-slides/slide-13.png" },
  { id: "slide-14", num: 14, title: "Leveraging Your Advantages", image: "/value-framework-slides/slide-14.png" },
  { id: "slide-15", num: 15, title: "Strategic Intent & Long-term Thinking", image: "/value-framework-slides/slide-15.png" },
  { id: "slide-16", num: 16, title: "Return on New Invested Capital", image: "/value-framework-slides/slide-16.png" },
  { id: "slide-17", num: 17, title: "Opportunity Cost vs Expected Return", image: "/value-framework-slides/slide-17.png" },
  { id: "slide-18", num: 18, title: "Growth Opportunities", image: "/value-framework-slides/slide-18.png" },
  { id: "slide-19", num: 19, title: "Decision Making Under Uncertainty", image: "/value-framework-slides/slide-19.png" },
  { id: "slide-20", num: 20, title: "Objective vs. Result", image: "/value-framework-slides/slide-20.png" },
  { id: "slide-21", num: 21, title: "The Growth Equation", image: "/value-framework-slides/slide-21.png" },
  { id: "slide-22", num: 22, title: "Investment Rate & Growth Rate", image: "/value-framework-slides/slide-22.png" },
  { id: "slide-23", num: 23, title: "Portfolio Management", image: "/value-framework-slides/slide-23.png" },
  { id: "slide-24", num: 24, title: "Types of Growth", image: "/value-framework-slides/slide-24.png" },
  { id: "slide-25", num: 25, title: "Leverage: Amplifying Returns and Risk", image: "/value-framework-slides/slide-25.png" },
  { id: "slide-26", num: 26, title: "Sustainability & Capital Structure", image: "/value-framework-slides/slide-26.png" },
  { id: "slide-27", num: 27, title: "Long-term Strategic Thinking", image: "/value-framework-slides/slide-27.png" },
  { id: "slide-28", num: 28, title: "Obsessive Focus on Value Creation", image: "/value-framework-slides/slide-28.png" },
  { id: "slide-29", num: 29, title: "Emotional Discipline", image: "/value-framework-slides/slide-29.png" },
  { id: "slide-30", num: 30, title: "Interconnected Systems", image: "/value-framework-slides/slide-30.png" },
  { id: "slide-31", num: 31, title: "Price Premium", image: "/value-framework-slides/slide-31.png" },
  { id: "slide-32", num: 32, title: "Effective Market Share", image: "/value-framework-slides/slide-32.png" },
  { id: "slide-33", num: 33, title: "Market Size: TAM, SAM, SOM", image: "/value-framework-slides/slide-33.png" },
  { id: "slide-34", num: 34, title: "Terminal Value: The Long Game", image: "/value-framework-slides/slide-34.png" },
  { id: "slide-35", num: 35, title: "Strategy Execution", image: "/value-framework-slides/slide-35.png" },
  { id: "slide-36", num: 36, title: "Customer Value", image: "/value-framework-slides/slide-36.png" },
  { id: "slide-37", num: 37, title: "Innovation: Breakthrough vs Incremental", image: "/value-framework-slides/slide-37.png" },
  { id: "slide-38", num: 38, title: "Exploring New Opportunities", image: "/value-framework-slides/slide-38.png" },
  { id: "slide-39", num: 39, title: "Building Value: From Seed to Scale", image: "/value-framework-slides/slide-39.png" },
];

function showSlide(slideId) {
  const slide = slides.find(s => s.id === slideId);
  if (!slide) return;

  // Update image
  document.getElementById('slide-image').src = slide.image;
  document.getElementById('current-slide').textContent = slide.num;

  // Update active state
  document.querySelectorAll('.slide-item').forEach(item => {
    item.classList.remove('active');
  });
  document.querySelector(`[data-slide="${slideId}"]`).classList.add('active');

  // Scroll to active item
  document.querySelector(`[data-slide="${slideId}"]`).scrollIntoView({ behavior: 'smooth', block: 'nearest' });
}

function initializeSlideList() {
  const listContainer = document.getElementById('slide-list');
  document.getElementById('total-slides').textContent = slides.length;

  slides.forEach(slide => {
    const button = document.createElement('button');
    button.className = `slide-item ${slide.num === 1 ? 'active' : ''}`;
    button.dataset.slide = slide.id;
    button.innerHTML = `
      <span class="slide-title">${slide.title}</span>
      <span class="slide-number">${slide.num}</span>
    `;
    button.addEventListener('click', () => showSlide(slide.id));
    listContainer.appendChild(button);
  });

  // Show first slide
  showSlide('slide-01');
}

// Initialize when DOM is ready
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', initializeSlideList);
} else {
  initializeSlideList();
}
</script>

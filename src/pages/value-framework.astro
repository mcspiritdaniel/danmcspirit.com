---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Value Framework - Dan McSpirit">
  <div id="shell">
    <!-- IDENTITY COLUMN -->
    <aside class="col col-identity">
      <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 30px;">
        <div class="name">Dan McSpirit</div>
        <div class="metadata">Denver, Colorado</div>
      </div>

      <h1 style="margin-bottom: 20px;">
        Value Framework
      </h1>

      <p style="margin-bottom: 16px;">
        How capital allocation determines whether value gets created or destroyed.
      </p>

      <p style="margin-bottom: 28px; color: var(--faint); font-size: 14px;">
        The principles that guide my work as an investor and builder. Teaching forces the clarity.
      </p>

      <div class="divider"></div>

      <a href="/" class="lnk" style="display: inline-block; margin-top: 24px; font-size: 13px;">← Back to portfolio</a>

      <div style="height: 46px;"></div>
      <div class="scrollfade"></div>
    </aside>

    <!-- CONCEPTS COLUMN -->
    <section class="col col-work">
      <div class="stickyhead">
        <span class="col-header-label" style="color: var(--navy);">Concepts</span>
      </div>

      <div class="pad" style="padding: 30px var(--sp-5xl);">
        <div class="concept-list">
          <button class="concept-item active" data-concept="price-value">
            <span>Price vs Value</span>
            <span class="concept-arrow">→</span>
          </button>
          <button class="concept-item" data-concept="capital-allocation">
            <span>Capital Allocation</span>
            <span class="concept-arrow">→</span>
          </button>
          <button class="concept-item" data-concept="leverage">
            <span>Leverage</span>
            <span class="concept-arrow">→</span>
          </button>
          <button class="concept-item" data-concept="risk-return">
            <span>Risk vs Return</span>
            <span class="concept-arrow">→</span>
          </button>
          <button class="concept-item" data-concept="verification">
            <span>Verification</span>
            <span class="concept-arrow">→</span>
          </button>
        </div>
      </div>

      <div class="scrollfade"></div>
    </section>

    <!-- DETAIL COLUMN -->
    <section class="col col-projects">
      <div class="pad" style="padding-top: var(--sp-3xl);">
        <div id="concept-detail">
          <!-- Content populated by JavaScript -->
        </div>
      </div>

      <div class="scrollfade"></div>
    </section>
  </div>
</MainLayout>

<style>
  .divider {
    height: 1px;
    background: var(--rule);
    margin: 40px 0;
  }

  .concept-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .concept-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 20px;
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--rule-light);
    cursor: pointer;
    text-align: left;
    font-family: var(--font-serif);
    font-size: 16px;
    font-weight: 400;
    color: var(--navy);
    transition: background 0.2s;
  }

  .concept-item:hover {
    background: #faf8f3;
  }

  .concept-item.active {
    background: #f5f3f0;
    border-left: 3px solid var(--navy);
    padding-left: 17px;
  }

  .concept-arrow {
    font-size: 14px;
    color: var(--faint);
    opacity: 0;
    transition: opacity 0.2s;
  }

  .concept-item:hover .concept-arrow {
    opacity: 1;
  }

  .concept-item.active .concept-arrow {
    opacity: 1;
    color: var(--navy);
  }

  .concept-title {
    font-family: var(--font-serif);
    font-size: 20px;
    font-weight: 500;
    color: var(--navy);
    margin-bottom: 24px;
  }

  .concept-content {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .concept-content p {
    font-size: 14px;
    line-height: 1.7;
    color: var(--ink);
    margin: 0;
  }

  .concept-content p.muted {
    color: var(--faint);
    font-style: italic;
  }

  .concept-graphic {
    margin-top: 24px;
    padding-top: 24px;
    border-top: 1px solid var(--rule-light);
  }

  .concept-graphic svg {
    width: 100%;
    max-width: 300px;
    height: auto;
  }
</style>

<script>
const concepts = {
  'price-value': {
    title: 'Price vs Value',
    content: `
      <p>Price is what you pay. Value is what you get. The gap between them is where opportunity and risk live.</p>
      <p>Most market participants confuse the two. A stock trading at $50 is not worth $50. Its price is $50. What you own—its cash generation, growth trajectory, competitive position, balance sheet strength—determines its value. When price and value diverge, you have either opportunity or danger.</p>
      <p class="muted">The discipline is in the work: building a model that captures what the business actually does, testing it against reality, and having the conviction to act when price and value are clearly misaligned.</p>
    `
  },
  'capital-allocation': {
    title: 'Capital Allocation',
    content: `
      <p>Every decision about where capital goes is a decision about value creation or destruction. This is true whether you're managing a company, a portfolio, or a career.</p>
      <p>A company that deploys capital into projects with returns above its cost of capital creates value. One that deploys below its cost of capital destroys it, regardless of how well it executes. Management's primary job is capital allocation.</p>
      <p>The same logic applies to your own capital—financial and human. Where you invest your attention, time, and money determines whether you create value for yourself and others.</p>
      <p class="muted">This is why I focus on companies and projects where capital has been systematically misallocated. The work is identifying what's being done wrong and what would create value if done differently.</p>
    `
  },
  'leverage': {
    title: 'Leverage',
    content: `
      <p>Leverage amplifies returns. It also amplifies risk. The mistake is treating it as separate from risk—it is risk.</p>
      <p>A company with no leverage might return 8% on equity. With 2x leverage, it might return 15%. But it's also one down quarter away from covenant violations and dilutive equity raises. The higher return comes with a tail risk that most investors price poorly.</p>
      <p>Leverage works beautifully in good times and devastates in bad ones. The companies that survive and prosper through cycles are those that use leverage only when they can sustain it through the worst scenarios they can imagine.</p>
      <p class="muted">When analyzing leverage, I work backward from: what would break this? Not what might break it. What would actually break it.</p>
    `
  },
  'risk-return': {
    title: 'Risk vs Return',
    content: `
      <p>Risk and return are inextricably linked. You cannot have high return without high risk. What you can have is high risk with low return—that's just bad investing.</p>
      <p>The hard part is identifying which risks are actually priced into the return you're being offered. A stock trading at 8x earnings in a stable, high-return business is lower risk than one trading at 20x earnings in a commodity business, regardless of what the volatility charts say.</p>
      <p>If you can't see the risk, you haven't looked hard enough. This is where most analysis fails. It's easy to model the base case. It's harder—and more important—to identify what could go wrong and whether you're being paid for that possibility.</p>
      <p class="muted">The returns go to those who can see risks others miss and price them correctly.</p>
    `
  },
  'verification': {
    title: 'Verification',
    content: `
      <p>Your model is not the business. Your model is how you think about the business. The gap between the two is where mistakes happen.</p>
      <p>Verification means stress-testing your model against reality. Running the numbers against what actually happened. Finding the places where your thinking was wrong. A model that passes verification is one you can trust. One that doesn't is just a story you told yourself.</p>
      <p>The best verification is simple: can you predict what happens next? If your model is right, you should be able to forecast results, and they should match. If they don't, your model is wrong.</p>
      <p class="muted">This is why I build regression harnesses and run second systems with no stake in the first one's conclusions. You need an independent check.</p>
    `
  }
};

function showConcept(conceptId) {
  const detail = document.getElementById('concept-detail');
  const concept = concepts[conceptId];

  detail.innerHTML = `
    <h2 class="concept-title">${concept.title}</h2>
    <div class="concept-content">
      ${concept.content}
    </div>
  `;

  // Update active state
  document.querySelectorAll('.concept-item').forEach(item => {
    item.classList.remove('active');
  });
  document.querySelector(`[data-concept="${conceptId}"]`).classList.add('active');
}

// Set up click handlers
document.querySelectorAll('.concept-item').forEach(item => {
  item.addEventListener('click', () => {
    showConcept(item.dataset.concept);
  });
});

// Show first concept by default
showConcept('price-value');
</script>

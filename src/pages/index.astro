<script is:inline>
function setupToggles() {
  document.querySelectorAll('.group-header').forEach(function(header) {
    header.style.cursor = 'pointer';
    header.onclick = function(e) {
      e.stopPropagation();
      const content = this.nextElementSibling;
      const toggle = this.querySelector('.group-toggle');
      if (content && content.classList.contains('group-content')) {
        this.classList.toggle('expanded');
        const isExpanded = this.classList.contains('expanded');
        content.style.display = isExpanded ? 'block' : 'none';
        if (toggle) {
          toggle.textContent = isExpanded ? '−' : '+';
        }
      }
    };
  });
}

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', setupToggles);
} else {
  setupToggles();
}
</script>


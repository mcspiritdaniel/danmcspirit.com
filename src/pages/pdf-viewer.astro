---
import MainLayout from '../layouts/MainLayout.astro';

const { file } = Astro.url.searchParams;

if (!file) {
  return Astro.redirect('/');
}
---

<MainLayout title={`PDF Viewer - Dan McSpirit`}>
  <div style="width: 100%; height: 100vh; display: flex; flex-direction: column; background: #f5f5f5;">
    <!-- Navigation Bar -->
    <div style="display: flex; align-items: center; padding: 16px 24px; background: white; border-bottom: 1px solid #ddd; gap: 16px;">
      <a href="/" style="display: inline-flex; align-items: center; gap: 6px; color: #23426a; text-decoration: none; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif; font-size: 14px;">
        ← Back
      </a>
    </div>

    <!-- PDF Container -->
    <div style="flex: 1; overflow: hidden;">
      <embed
        src={`/${file}`}
        type="application/pdf"
        style="width: 100%; height: 100%; border: none;"
      />
    </div>
  </div>
</MainLayout>
